            <mxRectangle width="135" height="90" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="WMgAMNH05QtY52NEjvcn-61" value="" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;" parent="WMgAMNH05QtY52NEjvcn-57" vertex="1">
          <mxGeometry x="533" width="134" height="90" as="geometry">
            <mxRectangle width="134" height="90" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="WMgAMNH05QtY52NEjvcn-62" value="" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;" parent="WMgAMNH05QtY52NEjvcn-57" vertex="1">
